{
  "name": "moonlitclear-astrowind",
  "version": "1.0.0-beta.66",
  "description": "AstroWind: A free template using Astro 7 and Tailwind CSS v4. Astro starter theme.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run assets:build && npm run content:sync && astro build && npm run fonts:serif && npm run verify && node scripts/compress.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint src vendor astro.config.ts",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "content:sync": "node scripts/sync-content.mjs",
    "verify": "node scripts/verify-build.mjs",
    "preview:replacement": "PORT=4333 PREVIEW_NOINDEX=1 node serve.mjs",
    "pack": "node scripts/pack.mjs",
    "article:new": "node scripts/new-article.mjs",
    "content:scan": "node scripts/sync-content.mjs --dry-run --mode preview",
    "content:discover": "node scripts/discover-creator-articles.mjs",
    "github:stats": "node scripts/update-github-stats.mjs --write",
    "build:local": "CONTENT_MODE=preview npm run build",
    "test:content": "node --test scripts/tests/content.test.mjs",
    "assets:build": "node scripts/build-brand-assets.mjs",
    "fonts:serif": "node scripts/build-serif-font.mjs"
  },
  "dependencies": {
    "@astro-community/astro-embed-twitter": "^0.5.11",
    "@astro-community/astro-embed-vimeo": "^0.3.12",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/outfit": "^5.2.8",
    "astro": "^7.3.1",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.2.0",
    "gray-matter": "^4.0.3",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "three": "^0.183.0",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/partytown": "^2.1.7",
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.0.0",
    "@types/three": "^0.183.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "astro-compress": "^2.4.3",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.9.0",
    "js-yaml": "^4.3.2",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^7.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "^0.35.3",
    "subset-font": "^2.9.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "astro-compress": {
      "sharp": "^0.35.3",
      "svgo": "^4.1.0"
    },
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "deepmerge-ts": ">=8.0.2",
    "fast-uri": "^3.1.6"
  }
}
