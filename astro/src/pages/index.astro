---
import Layout from '~/layouts/SiteLayout.astro';
import Hero from '~/components/v6/home/Hero.astro';
import Stats from '~/components/v6/home/Stats.astro';
import Products from '~/components/v6/home/Products.astro';
import OpenSource from '~/components/v6/home/OpenSource.astro';
import Articles from '~/components/v6/home/Articles.astro';
import Offers from '~/components/v6/home/Offers.astro';
import ClosingCta from '~/components/v6/home/ClosingCta.astro';
import { fetchPosts } from '~/utils/blog';
import { projects } from '~/data/brand';
import { openSourceEntries } from '~/data/open-source';
import githubStats from '~/data/github-stats.json';

const allPosts = await fetchPosts();
const totalStars = Object.values(githubStats.repos).reduce((sum, repo) => sum + repo.stars, 0);
const stats = [
  { value: projects.length, label: '个产品', pad: true },
  { value: openSourceEntries.length, label: '个开源项目', growing: true },
  { value: totalStars, label: 'GitHub Star', growing: true },
  { value: allPosts.length, label: '篇文章', growing: true },
];
---

<Layout
  metadata={{
    title: '朱志勇的产品、文章与开源实践',
    description: '月明Verse｜朱志勇。一个人做产品、做内容、做增长，记录 AI Native 实践、工具实测与产品从 0 到 1。',
  }}
>
  <div class="v6-page">
    <Hero productCount={projects.length} openSourceCount={openSourceEntries.length} postCount={allPosts.length} />
    <Stats stats={stats} />
    <Products />
    <OpenSource />
    <Articles posts={allPosts.slice(0, 8)} total={allPosts.length} />
    <Offers />
    <ClosingCta />
  </div>
</Layout>

<script>
  import { initHomeV6 } from '~/scripts/v6-home';
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = initHomeV6();
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
