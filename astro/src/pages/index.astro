---
import Layout from '~/layouts/SiteLayout.astro';
import ProfileHero from '~/components/moonlit/ProfileHero.astro';
import ProjectCards from '~/components/moonlit/ProjectCards.astro';
import OpenSourceCards from '~/components/moonlit/OpenSourceCards.astro';
import ArticleCard from '~/components/moonlit/ArticleCard.astro';
import LinksPanel from '~/components/moonlit/LinksPanel.astro';
import { fetchPosts } from '~/utils/blog';
import { projects } from '~/data/brand';
import { openSourceEntries } from '~/data/open-source';
const allPosts = await fetchPosts();
const posts = allPosts.slice(0, 6);
const tabs = [
  { id: 'work', label: '产品', count: String(projects.length).padStart(2, '0') },
  { id: 'opensource', label: '开源', count: String(openSourceEntries.length).padStart(2, '0') },
  { id: 'articles', label: '文章', count: String(allPosts.length) },
  { id: 'links', label: '链接', count: '↗' },
];
---

<Layout
  metadata={{
    title: '朱志勇的产品、文章与开源实践',
    description: '月明Verse｜朱志勇。一个人做产品、做内容、做增长，记录 AI Native 实践、工具实测与产品从 0 到 1。',
  }}
>
  <ProfileHero />
  <section class="home-index" id="explore" aria-label="月明Verse的作品与记录">
    <div class="index-heading"><span class="eyebrow">01 / 作品与记录</span><p>做过的项目，写下的笔记。</p></div>
    <div class="index-tabs" aria-label="内容分类">
      {
        tabs.map((tab) => (
          <a id={`tab-${tab.id}`} href={`#${tab.id}`} data-home-tab={tab.id}>
            {tab.label}
            <sup>{tab.count}</sup>
          </a>
        ))
      }
    </div>
    <div class="index-panels">
      <section id="work" data-home-panel aria-labelledby="tab-work"><ProjectCards /></section>
      <section id="opensource" data-home-panel aria-labelledby="tab-opensource">
        <div class="index-panel-heading">
          <h2>把做事的方法，开源成可用的工具。</h2><p>从独立软件到内容工作流，所有项目都在同一个目录里。</p>
        </div>
        <OpenSourceCards />
        <a class="opensource-directory-link" href="/opensource">
          <span><strong>{openSourceEntries.length}</strong> 个开源项目，覆盖软件与创作工具</span><b
            >查看全部开源项目 ↗</b
          >
        </a>
      </section>
      <section id="articles" data-home-panel aria-labelledby="tab-articles">
        <div class="index-panel-heading">
          <h2>思考的过程，也值得留下。</h2><a href="/blog" class="text-arrow">全部 {allPosts.length} 篇文章 ↗</a>
        </div>
        <div class="article-grid">
          {posts.map((post, index) => <ArticleCard post={post} featured={index === 0 && !!post.workId} />)}
        </div>
      </section>
      <section id="links" data-home-panel aria-labelledby="tab-links">
        <LinksPanel />
      </section>
    </div>
  </section>
  <div class="home-signoff">
    <span>边做边学。</span><p>有新的尝试，就在这里记一笔。</p><a href="/links">有想交流的，欢迎来聊 ↗</a>
  </div>
</Layout>
<script>
  import { initHomeIndex } from '~/scripts/home-index';
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = initHomeIndex();
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  .opensource-directory-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    margin-top: 46px;
    padding: 22px 24px;
    border: 1px solid var(--brand-border);
    border-radius: 14px;
    color: var(--brand-body);
    background: #fff;
    text-decoration: none;
  }
  .opensource-directory-link strong,
  .opensource-directory-link b {
    color: var(--brand-ink);
  }
  .opensource-directory-link strong {
    margin-right: 4px;
    font-size: 21px;
  }
  .opensource-directory-link b {
    white-space: nowrap;
  }
  .opensource-directory-link:hover b {
    color: var(--brand-accent);
  }
  @media (max-width: 650px) {
    .opensource-directory-link {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 32px;
      padding: 18px;
    }
  }
</style>
