---
import PageLayout from './PageLayout.astro';
import '~/assets/styles/brand-tokens.css';
import Header from '~/components/moonlit/Header.astro';
import SiteAtmosphere from '~/components/moonlit/SiteAtmosphere.astro';
import Footer from '~/components/moonlit/Footer.astro';
import type { MetaData } from '~/types';
interface Props {
  metadata?: MetaData;
}
const { metadata = {} } = Astro.props;
---

<PageLayout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Header slot="header" />
  <div class="brand-grid-bg" aria-hidden="true"></div>
  <SiteAtmosphere />
  <slot name="head" slot="head" />
  <slot />
  <Footer slot="footer" />
</PageLayout>
