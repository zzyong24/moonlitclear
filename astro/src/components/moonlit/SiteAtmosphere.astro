---
// v6：全站不再挂载流线背景（docs/redesign-v6/01 §6），代码保留以便回滚。Keep long reading and product-detail pages quiet. No content artwork is drawn here.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const contourPaths: string[] = []; // 回滚：恢复为 ['/', '/projects', '/blog', '/opensource']
const showContours = contourPaths.includes(path);
---

{showContours && <canvas class="brand-contours" data-brand-contours aria-hidden="true" />}

<script>
  import '~/scripts/site-interactions';
</script>

<style>
  .brand-contours {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    /* Full-width layers; only individual text blocks get a soft reading surface. */
    background:
      radial-gradient(ellipse at 35% 22%, #c9ddec90, transparent 58%),
      radial-gradient(ellipse at 74% 72%, #f0d6bf80, transparent 62%);
  }
  :global(body:has([data-brand-contours]) .profile-copy),
  :global(body:has([data-brand-contours]) .product-copy),
  :global(body:has([data-brand-contours]) .article-card__body) {
    background: linear-gradient(100deg, #fffcf8d9, #fffcf8a8 70%, #fffcf854);
    border-radius: 14px;
    box-shadow: 0 0 26px 12px #fffcf85c;
  }
  :global(body:has([data-brand-contours]) .index-tabs) {
    background: #fffcf8c7;
  }
  @media (max-width: 700px) {
    .brand-contours {
      opacity: 0.65;
    }
  }
</style>
