---
// Shared palette and system font stack live in brand-tokens.css.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--brand-font);
    --aw-font-serif: var(--brand-font);
    --aw-font-heading: var(--brand-font);

    --aw-color-primary: var(--brand-accent);
    --aw-color-secondary: var(--brand-copper);
    --aw-color-accent: var(--brand-accent);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(8 9 10);

    ::selection {
      background-color: var(--brand-apricot);
    }
  }

  .dark {
    --aw-font-sans: var(--brand-font);
    --aw-font-serif: var(--brand-font);
    --aw-font-heading: var(--brand-font);

    --aw-color-primary: var(--brand-accent);
    --aw-color-secondary: var(--brand-copper);
    --aw-color-accent: var(--brand-accent);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(8 9 10);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
