---
interface Stat {
  value: number;
  label: string;
  growing?: boolean;
  pad?: boolean;
}
interface Props {
  stats: Stat[];
  tags: string[];
}
const { stats, tags } = Astro.props;
const shown = stats.filter((s) => s.value > 0);
const format = (s: Stat) =>
  s.value >= 1000 ? (s.value / 1000).toFixed(1) + 'K' : s.pad ? String(s.value).padStart(2, '0') : String(s.value);
---

<section class="v6-section v6-section--sm" data-tone="light" data-bg="moon-50" aria-labelledby="stats-title">
  <div class="v6-container">
    <h2 id="stats-title" class="sr-only">数字一览</h2>
    <dl class="v6-stats">
      {
        shown.map((s, i) => (
          <div data-reveal style={`--reveal-i:${i}`}>
            <dt class="v6-small">{s.label}</dt>
            <dd>
              <span
                class="v6-stat"
                data-count-to={s.value < 1000 ? s.value : undefined}
                data-count-format={s.pad ? 'pad2' : undefined}
              >
                {format(s)}
              </span>
              {s.growing && (
                <sup class="v6-stats__plus" aria-hidden="true">
                  +
                </sup>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="v6-stats__tags">
      <span class="v6-small">我在做的方向</span>
      <ul>{tags.map((t) => <li>{t}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .v6-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }
  .v6-stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 14px;
    padding: 4px 24px 4px 28px;
    border-left: 1px solid var(--v6-line);
  }
  .v6-stats > div:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .v6-stats dd {
    margin: 0;
    display: flex;
    align-items: flex-start;
  }
  .v6-stats__plus {
    top: 0;
    margin-left: 4px;
    font-size: 22px;
    font-weight: 500;
    line-height: 1;
    color: var(--v6-accent);
  }
  .v6-stats__tags {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--v6-line);
  }
  .v6-stats__tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .v6-stats__tags li {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--v6-fg);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .v6-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 0;
    }
    .v6-stats > div,
    .v6-stats > div:first-child {
      border-left: 0;
      padding: 0;
    }
    .v6-stats__tags {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin-top: 36px;
    }
    .v6-stats__tags ul {
      gap: 8px 20px;
    }
  }
</style>
