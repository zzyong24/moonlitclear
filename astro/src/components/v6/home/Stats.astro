---
import { socials } from '~/data/brand';
import { communityUrl } from '~/data/offers';
interface Stat {
  value: number;
  label: string;
  growing?: boolean;
  pad?: boolean;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
const channels = [...socials, { name: '知识星球', url: communityUrl }];
const shown = stats.filter((s) => s.value > 0);
const format = (s: Stat) =>
  s.value >= 1000 ? (s.value / 1000).toFixed(1) + 'K' : s.pad ? String(s.value).padStart(2, '0') : String(s.value);
---

<section class="v6-proof" data-tone="light" aria-labelledby="stats-title">
  <div class="v6-container">
    <h2 id="stats-title" class="sr-only">数字一览</h2>
    <dl class="v6-stats">
      {
        shown.map((s, i) => (
          <div data-reveal style={`--reveal-i:${i}`}>
            <dt class="v6-small">{s.label}</dt>
            <dd>
              <span
                class="v6-stat"
                data-count-to={s.value < 1000 ? s.value : undefined}
                data-count-format={s.pad ? 'pad2' : undefined}
              >
                {format(s)}
              </span>
              {s.growing && (
                <sup class="v6-stats__plus" aria-hidden="true">
                  +
                </sup>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="v6-proof__row">
      <span class="v6-proof__label">在这些地方更新</span>
      <ul>
        {
          channels.map((c) => (
            <li>
              <a href={c.url} target="_blank" rel="noreferrer">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .v6-proof {
    background: var(--moon-50);
    border-bottom: 1px solid var(--line-light);
  }
  .v6-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding-block: 44px 34px;
  }
  .v6-stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding: 4px 28px;
    border-left: 1px solid var(--v6-line);
  }
  .v6-stats > div:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .v6-stats dt {
    font-size: 14.5px;
    color: var(--v6-fg-3);
  }
  .v6-stats dd {
    margin: 0;
    display: flex;
    align-items: flex-start;
  }
  .v6-stats__plus {
    top: 0;
    margin-left: 2px;
    font-family: var(--font-num);
    font-size: 22px;
    font-weight: 600;
    line-height: 1;
    color: var(--v6-accent);
  }
  .v6-proof__row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    column-gap: 28px;
    align-items: baseline;
    padding-block: 20px 22px;
    border-top: 1px solid var(--v6-line);
  }
  .v6-proof__label {
    font-size: 13.5px;
    color: var(--v6-fg-3);
  }
  .v6-proof__row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .v6-proof__row a {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 0.02em;
    color: #4a525e;
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }
  .v6-proof__row a:hover {
    color: var(--copper);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .v6-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 28px;
      padding-block: 36px 30px;
    }
    .v6-stats > div:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .v6-proof__row {
      grid-template-columns: 1fr;
      row-gap: 10px;
    }
    .v6-proof__row ul {
      gap: 6px 22px;
    }
  }
  @media (max-width: 380px) {
    .v6-stats > div {
      padding-inline: 16px 0;
    }
  }
</style>
