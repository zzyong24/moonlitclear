---
import { getImage } from 'astro:assets';
import portrait from '~/assets/moonlit/portrait-cutout-v1.png';
import brushMark from '~/assets/moonlit/brush-yueming.svg?raw';
import SocialIcons from '../SocialIcons.astro';
interface Stat {
  value: number;
  label: string;
  growing?: boolean;
  pad?: boolean;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
const shown = stats.filter((s) => s.value > 0);
const format = (s: Stat) => (s.pad ? String(s.value).padStart(2, '0') : String(s.value));
const widths = [360, 520, 720, 1000];
const images = await Promise.all(
  widths.map((width) => getImage({ src: portrait, width, format: 'webp', quality: 82 }))
);
const ratio = portrait.height / portrait.width;
---

<section class="v6-hero v6-grain" data-tone="dark" aria-labelledby="hero-title">
  <div class="v6-container v6-hero__wrap">
    <div class="v6-hero__copy">
      <p class="v6-kicker rise">朱志勇 · 月明Verse · 武汉</p>
      <h1 id="hero-title" class="v6-display rise d1">
        <span>先做出来，</span><span>再老实复盘。</span>
      </h1>
      <p class="v6-lead rise d2">
        我是朱志勇，网上叫<b>月明Verse</b>。00 后，白天是全栈工程师，下班后用 AI 做自己的产品。卖出过第一笔
        <b>18.8 元</b>，也给自己搭的系统打过 <b>6 分</b>。做出来的东西和每一次复盘，都放在这里。
      </p>
      <div class="v6-hero__actions rise d3">
        <a class="v6-btn v6-btn--primary" href="#products">看做出来的东西</a>
        <a class="v6-btn v6-btn--secondary" href="#retros">读复盘</a>
      </div>
      <div class="rise d4"><SocialIcons label="关注我" /></div>
    </div>
    <div class="v6-hero__art">
      <div class="v6-hero__mark" set:html={brushMark} />
      <img
        class="v6-hero__portrait"
        src={images[1].src}
        srcset={images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ')}
        sizes="(max-width: 860px) 60vw, 380px"
        width={520}
        height={Math.round(520 * ratio)}
        alt="朱志勇，身穿深蓝西装和白色上衣，面带微笑"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>

  <div class="v6-hero__band">
    <div class="v6-container">
      <h2 id="stats-title" class="sr-only">数字一览</h2>
      <dl class="v6-hero__stats" style={`--n:${shown.length}`}>
        {
          shown.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>
                <span class="v6-num" data-count-to={s.value} data-count-format={s.pad ? 'pad2' : undefined}>
                  {format(s)}
                </span>
                {s.growing && <sup aria-hidden="true">+</sup>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .v6-hero {
    position: relative;
    overflow: hidden;
    background: var(--night-800);
  }
  .v6-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 70% at 72% 40%, rgba(120, 150, 230, 0.22), transparent 70%),
      radial-gradient(40% 50% at 8% 100%, rgba(0, 0, 0, 0.28), transparent 70%);
  }
  .v6-hero__wrap {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    align-items: center;
    gap: 24px;
    padding-top: clamp(120px, 10vw, 148px);
  }
  .v6-hero__copy {
    padding-bottom: 56px;
  }
  .v6-hero__copy h1 {
    margin-top: 26px;
  }
  .v6-hero__copy h1 span {
    display: block;
    white-space: nowrap;
  }
  .v6-hero__copy .v6-lead {
    max-width: 28em;
    margin-top: 26px;
  }
  .v6-lead b {
    white-space: nowrap;
    font-weight: 500;
    color: var(--v6-fg);
  }
  .v6-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .v6-hero__copy > .rise:last-child {
    margin-top: 28px;
  }

  .v6-hero__art {
    position: relative;
    align-self: end;
    height: clamp(460px, 42vw, 600px);
  }
  .v6-hero__mark {
    position: absolute;
    top: 8%;
    left: 50%;
    width: 120%;
    transform: translateX(-50%);
    color: var(--moon-cream);
    opacity: 0.95;
  }
  .v6-hero__mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .v6-hero__portrait {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 1;
    width: auto;
    max-width: none;
    height: 100%;
    transform: translateX(-50%);
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.22));
  }

  .v6-hero__band {
    position: relative;
    z-index: 1;
    background: var(--night-900);
    padding-block: 32px 34px;
  }
  .v6-hero__stats {
    display: grid;
    grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    margin: 0;
  }
  .v6-hero__stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 2px 28px;
    border-left: 1px solid var(--line-dark);
  }
  .v6-hero__stats > div:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .v6-hero__stats dt {
    font-size: 14px;
    color: var(--moon-cream-3);
  }
  .v6-hero__stats dd {
    display: flex;
    align-items: flex-start;
    margin: 0;
  }
  .v6-hero__stats .v6-num {
    font-size: clamp(32px, 3.2vw, 46px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--moon-cream);
  }
  .v6-hero__stats sup {
    top: 0;
    margin-left: 2px;
    font-family: var(--font-num);
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
    color: var(--copper-moon);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .rise {
    animation: v6-rise 0.9s var(--ease-out) both;
  }
  .rise.d1 {
    animation-delay: 0.25s;
  }
  .rise.d2 {
    animation-delay: 0.4s;
  }
  .rise.d3 {
    animation-delay: 0.55s;
  }
  .rise.d4 {
    animation-delay: 0.7s;
  }
  .v6-hero__mark {
    animation: v6-mark-in 1.25s cubic-bezier(0.7, 0, 0.2, 1) 0.15s both;
  }
  .v6-hero__portrait {
    animation: v6-rise-portrait 0.9s var(--ease-out) 0.35s both;
  }
  @keyframes v6-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes v6-mark-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes v6-rise-portrait {
    from {
      opacity: 0;
      transform: translate(-50%, 24px);
    }
  }

  @media (max-width: 860px) {
    .v6-hero__wrap {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 84px;
    }
    .v6-hero__art {
      order: -1;
      height: min(104vw, 440px);
    }
    .v6-hero__mark {
      width: 108%;
      top: 12%;
    }
    .v6-hero__portrait {
      height: 96%;
    }
    .v6-hero__copy {
      padding-bottom: 48px;
    }
    .v6-hero__copy h1 {
      margin-top: 28px;
    }
    .v6-hero__actions .v6-btn {
      flex: 1 1 0;
    }
    .v6-hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 24px;
    }
    .v6-hero__stats > div:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise,
    .v6-hero__mark,
    .v6-hero__portrait {
      animation: none;
    }
  }
</style>
