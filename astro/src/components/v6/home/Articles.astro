---
import { pullQuote } from '~/data/capabilities';
import SectionHeading from '../SectionHeading.astro';
import type { Post } from '~/types';
interface Props {
  posts: Post[];
  total: number;
}
const { posts, total } = Astro.props;
const quotePost = posts.find((p) => p.title.includes(pullQuote.match));
const list = posts.filter((p) => p !== quotePost).slice(0, 6);
const ym = (d: Date) => d.toISOString().slice(0, 7).replace('-', '.');
---

<section class="v6-section" id="articles" data-tone="light" data-bg="moon-50" aria-labelledby="articles-title">
  <div class="v6-container">
    <SectionHeading
      id="articles-title"
      eyebrow="文章"
      title="方法与实战，<br />都写成了文章。"
      lead="AI 协作、Agent 工程、知识库与内容系统。每篇都来自真实项目，步骤和数据写清楚，读完就能照着用。"
      linkHref="/blog"
      linkLabel={`全部 ${total} 篇文章`}
    />

    {
      quotePost && (
        <figure class="v6-quote" data-reveal>
          <blockquote>
            <p>{pullQuote.text}</p>
          </blockquote>
          <figcaption>
            摘自
            <a href={'/' + quotePost.permalink}>《{quotePost.title}》</a>
          </figcaption>
        </figure>
      )
    }

    <ol class="v6-rows">
      {
        list.map((p, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <a href={'/' + p.permalink}>
              <time class="v6-num" datetime={p.publishDate.toISOString()}>
                {ym(p.publishDate)}
              </time>
              <span class="v6-rows__main">
                <strong class="v6-h3">{p.title}</strong>
                {p.excerpt && <span class="v6-small">{p.excerpt}</span>}
              </span>
              <span class="v6-rows__go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }
  .v6-quote {
    margin: 0 0 48px;
    padding: 4px 0 4px 28px;
    border-left: 2px solid var(--copper);
  }
  .v6-quote blockquote {
    margin: 0;
  }
  .v6-quote p {
    max-width: 30em;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 900;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .v6-quote figcaption {
    margin-top: 14px;
    font-size: 14px;
    color: var(--muted);
  }
  .v6-quote figcaption a {
    color: var(--copper);
  }
  .v6-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--v6-fg);
  }
  .v6-rows a {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    column-gap: 28px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--v6-line);
  }
  .v6-rows time {
    font-size: 13px;
    font-weight: 500;
    color: var(--v6-fg-3);
  }
  .v6-rows__main {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .v6-rows__main .v6-h3 {
    font-size: 22px;
    font-weight: 900;
    line-height: 1.45;
    transition: color var(--dur-fast) ease;
  }
  .v6-rows__main .v6-small {
    max-width: 40em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 15px;
    line-height: 1.8;
  }
  .v6-rows__go {
    font-size: 15px;
    color: var(--v6-fg-3);
    transition:
      color var(--dur-fast) ease,
      transform var(--dur-fast) ease;
  }
  .v6-rows a:hover .v6-h3,
  .v6-rows a:hover .v6-rows__go {
    color: var(--v6-accent);
  }
  .v6-rows a:hover .v6-rows__go {
    transform: translate(2px, -2px);
  }
  @media (max-width: 767px) {
    .v6-quote {
      padding-left: 18px;
      margin-bottom: 36px;
    }
    .v6-rows a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 16px;
      padding: 20px 0;
    }
    .v6-rows time {
      grid-column: 1 / -1;
    }
    .v6-rows__main .v6-h3 {
      font-size: 19px;
    }
    .v6-rows__main .v6-small {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>
