---
import SectionHeading from '../SectionHeading.astro';
import { offers, testimonials } from '~/data/offers';
---

<section class="v6-section v6-grain" id="offers" data-tone="dark" data-bg="night-900" aria-labelledby="offers-title">
  <div class="v6-container">
    <SectionHeading
      id="offers-title"
      eyebrow="合作"
      title="三种合作方式，<br />按需选择。"
      lead="从一个具体问题的咨询，到团队级的落地陪跑，再到长期的社群交流。"
    />
    <div class="v6-offers">
      {
        offers.map((o, i) => {
          const external = 'external' in o.action && o.action.external;
          return (
            <article
              class:list={['v6-offer', { 'v6-offer--accent': i === 0 }]}
              data-tone={i === 0 ? 'light' : 'dark'}
              data-reveal
              style={`--reveal-i:${i}`}
            >
              <div class="v6-offer__top">
                <span class="v6-small">{o.label}</span>
                <strong class="v6-offer__price">
                  {o.price}
                  {'unit' in o && <small>{o.unit}</small>}
                </strong>
              </div>
              <h3 class="v6-h3">{o.title}</h3>
              <p class="v6-body">{o.description}</p>
              {'topics' in o && (
                <ul class="v6-offer__topics">
                  {o.topics.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              {'note' in o && <p class="v6-small v6-offer__note">{o.note}</p>}
              <a
                class:list={i === 0 ? ['v6-btn', 'v6-btn--primary'] : ['v6-offer__go']}
                href={o.action.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noreferrer' : undefined}
              >
                {o.action.label}{' '}
                <span class="v6-arrow" aria-hidden="true">
                  {external ? '↗' : '→'}
                </span>
              </a>
            </article>
          );
        })
      }
    </div>
    <ul class="v6-voices">
      {
        testimonials.map((t, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <blockquote>「{t.quote}」</blockquote>
            <span class="v6-small">
              {t.who} · {t.role}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .v6-offers {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    gap: 20px;
    align-items: stretch;
  }
  .v6-offer {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px 26px 24px;
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 1px var(--v6-line);
    transition: box-shadow var(--dur-base) ease;
  }
  .v6-offer:not(.v6-offer--accent):hover {
    box-shadow: 0 0 0 1px var(--v6-line-strong);
  }
  .v6-offer--accent {
    background: #f8f0e2;
    box-shadow: none;
  }
  .v6-offer .v6-h3 {
    font-weight: 900;
  }
  .v6-offer__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--v6-line);
  }
  .v6-offer__price {
    font-family: var(--font-num);
    font-size: 24px;
    font-weight: 600;
    color: var(--v6-fg);
  }
  .v6-offer__price small {
    margin-left: 4px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--v6-fg-2);
  }
  .v6-offer__topics {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .v6-offer__topics li {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--v6-fg-2);
  }
  .v6-offer__topics li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 1px;
    background: var(--v6-accent);
  }
  .v6-offer__note {
    margin: 0;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--v6-fg) 6%, transparent);
  }
  .v6-offer .v6-btn,
  .v6-offer__go {
    margin-top: auto;
  }
  .v6-offer .v6-btn {
    align-self: stretch;
  }
  .v6-offer__go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding-top: 18px;
    font-size: 15px;
    font-weight: 500;
    color: var(--v6-fg);
    text-decoration: none;
  }
  .v6-offer__go:hover {
    color: var(--copper-moon);
  }
  .v6-voices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 40px 0 0;
    padding: 28px 0 0;
    list-style: none;
    border-top: 1px solid var(--v6-line);
  }
  .v6-voices li {
    display: grid;
    gap: 10px;
  }
  .v6-voices blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 900;
    line-height: 1.7;
    color: var(--v6-fg);
  }
  @media (max-width: 1023px) {
    .v6-voices {
      grid-template-columns: 1fr;
    }
    .v6-offers {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .v6-offer {
      padding: 20px;
    }
  }
</style>
