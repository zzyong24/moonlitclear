---
import { getImage } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import { projects } from '~/data/brand';
import { productNotes } from '~/data/product-notes';
import movingShot from '~/assets/products/moving-main.webp';

const countZh = ['零', '一', '两', '三', '四', '五', '六', '七', '八', '九', '十'];
const nLabel = countZh[projects.length] ?? String(projects.length);
const featured = projects.find((p) => p.id === 'moving') ?? projects[0];
// 目录顺序跟 product-notes.ts 的键顺序走，方便按状态调整。
const order = Object.keys(productNotes);
const rank = (id: string) => (order.indexOf(id) < 0 ? order.length : order.indexOf(id));
const rest = projects.filter((p) => p !== featured).sort((a, b) => rank(a.id) - rank(b.id));
const widths = [640, 960, 1400];
const shots = await Promise.all(
  widths.map((width) => getImage({ src: movingShot, width, format: 'webp', quality: 84 }))
);
const note = (id: string) => productNotes[id];
---

<section
  class="v6-section v6-grain"
  id="products"
  data-tone="dark"
  data-bg="night-800"
  aria-labelledby="products-title"
>
  <div class="v6-container">
    <SectionHeading
      id="products-title"
      eyebrow="产品"
      title={`一个人，<br />${nLabel}个产品。`}
      lead="每个都从我自己卡住的地方开始：做视频、做抖音、写代码、整理资料、带孩子。有的在卖，有的还在内测，状态照实写。"
      linkHref="/projects"
      linkLabel="产品详情"
    />

    <a class="v6-feature" href={`/projects/${featured.id}`} data-reveal>
      <div class="v6-feature__copy">
        <span class="v6-feature__status">{note(featured.id)?.status ?? featured.tag}</span>
        <h3 class="v6-feature__name">{featured.name}</h3>
        <p class="v6-feature__headline">{featured.headline}</p>
        <p class="v6-feature__note">{note(featured.id)?.note ?? featured.description}</p>
        <ul class="v6-feature__list">{featured.features.map((f) => <li>{f}</li>)}</ul>
        <span class="v6-feature__go">
          看看它怎么用{' '}
          <span class="v6-arrow" aria-hidden="true"> → </span>
        </span>
      </div>
      <figure class="v6-window">
        <div class="v6-window__bar" aria-hidden="true"><i></i><i></i><i></i><span>媒措 Moving · 真实界面</span></div>
        <img
          src={shots[1].src}
          srcset={shots.map((s, i) => `${s.src} ${widths[i]}w`).join(', ')}
          sizes="(max-width: 1023px) 92vw, 700px"
          width={movingShot.width}
          height={movingShot.height}
          alt="媒措 Moving 客户端主界面：左侧项目与会话，中间对话制作区，右侧项目文件"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </a>

    <ol class="v6-index">
      {
        rest.map((p, i) => (
          <li data-reveal style={`--reveal-i:${i % 3}`}>
            <a href={`/projects/${p.id}`} aria-label={`${p.name}：${note(p.id)?.status ?? p.tag}`}>
              <span class="v6-index__no">{String(i + 2).padStart(2, '0')}</span>
              <span class="v6-index__name">
                <strong>{p.name}</strong>
                <small>{note(p.id)?.status ?? p.tag}</small>
              </span>
              <span class="v6-index__note">{note(p.id)?.note ?? p.description}</span>
              <span class="v6-index__go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }
  .v6-feature {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 56px;
    align-items: center;
    margin-bottom: 56px;
  }
  .v6-feature__copy {
    display: grid;
    justify-items: start;
    gap: 14px;
  }
  .v6-feature__status {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--copper-moon);
  }
  .v6-feature__name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(30px, 2.8vw, 40px);
    font-weight: 900;
    letter-spacing: 0.02em;
    color: var(--moon-cream);
  }
  .v6-feature__headline {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 900;
    line-height: 1.6;
    color: var(--moon-cream);
  }
  .v6-feature__note {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.8;
    color: var(--moon-cream-2);
  }
  .v6-feature__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .v6-feature__list li {
    padding: 3px 10px;
    border-radius: var(--radius-xs);
    font-size: 13px;
    color: var(--moon-cream-2);
    box-shadow: inset 0 0 0 1px var(--line-dark);
  }
  .v6-feature__go {
    display: inline-flex;
    gap: 8px;
    margin-top: 10px;
    padding-bottom: 2px;
    font-size: 15px;
    font-weight: 500;
    color: var(--moon-cream);
    border-bottom: 1px solid var(--line-dark-strong);
  }
  .v6-feature:hover .v6-feature__go {
    border-color: var(--copper-moon);
  }
  .v6-window {
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #f4f4f7;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 40px 80px -40px rgba(0, 0, 0, 0.8);
    transition: transform 500ms var(--ease-out);
  }
  .v6-feature:hover .v6-window {
    transform: translateY(-4px);
  }
  .v6-window__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 14px;
    background: #e9e9ee;
    border-bottom: 1px solid #dcdce2;
  }
  .v6-window__bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d0d0d6;
  }
  .v6-window__bar span {
    margin-left: 10px;
    font-size: 12px;
    color: #7a7a86;
  }
  .v6-window img {
    display: block;
    width: 100%;
    height: auto;
  }

  .v6-index {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-dark-strong);
  }
  .v6-index a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 15rem) minmax(0, 1fr) auto;
    column-gap: 28px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-dark);
  }
  .v6-index__no {
    font-family: var(--font-num);
    font-size: 14px;
    font-weight: 600;
    color: var(--moon-cream-3);
  }
  .v6-index__name {
    display: grid;
    gap: 4px;
  }
  .v6-index__name strong {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 900;
    letter-spacing: 0.02em;
    color: var(--moon-cream);
    transition: color var(--dur-fast) ease;
  }
  .v6-index__name small {
    font-size: 12.5px;
    color: var(--copper-moon);
  }
  .v6-index__note {
    font-size: 15px;
    line-height: 1.8;
    color: var(--moon-cream-2);
  }
  .v6-index__go {
    color: var(--moon-cream-3);
    transition:
      color var(--dur-fast) ease,
      transform var(--dur-fast) ease;
  }
  .v6-index a:hover strong,
  .v6-index a:hover .v6-index__go {
    color: var(--copper-moon);
  }
  .v6-index a:hover .v6-index__go {
    transform: translateX(3px);
  }
  @media (max-width: 1023px) {
    .v6-feature {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .v6-window {
      order: -1;
    }
  }
  @media (max-width: 720px) {
    .v6-index a {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      row-gap: 8px;
      column-gap: 14px;
      padding: 20px 0;
    }
    .v6-index__note {
      grid-column: 2 / 3;
    }
    .v6-index__go {
      grid-row: 1;
      grid-column: 3;
    }
  }
</style>
