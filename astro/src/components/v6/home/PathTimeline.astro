---
import { timeline } from '~/data/timeline';
const items = timeline.filter((item) => !item.draft);
---

{
  items.length > 1 && (
    <section
      class="v6-section v6-section--sm v6-path"
      data-tone="dark"
      data-bg="night-900"
      aria-labelledby="path-title"
    >
      <div class="v6-container">
        <div class="v6-path__head">
          <span class="v6-eyebrow" id="path-title">
            路径 · Path
          </span>
          <p class="v6-small">从写代码，到一个人做完整的产品。</p>
        </div>
        <ol class="v6-path__rail">
          {items.map((item) => (
            <li class:list={{ 'is-current': item.current }}>
              <span class="v6-path__dot" aria-hidden="true" />
              <span class="v6-small v6-path__period">{item.period}</span>
              <strong class="v6-h4">{item.title}</strong>
              {item.note && <span class="v6-small">{item.note}</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .v6-path__head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 36px;
  }
  .v6-path__head p {
    margin: 0;
  }
  .v6-path__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    position: relative;
  }
  .v6-path__rail::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 1px;
    background: var(--v6-line-strong);
  }
  .v6-path__rail li {
    position: relative;
    display: grid;
    gap: 6px;
    padding-top: 28px;
  }
  .v6-path__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--v6-fg-2);
    background: var(--night-900);
  }
  .is-current .v6-path__dot {
    background: var(--copper-moon);
    border-color: var(--copper-moon);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--copper-moon) 22%, transparent);
  }
  .is-current strong {
    color: var(--copper-moon);
  }
  @media (max-width: 767px) {
    .v6-path__head {
      flex-direction: column;
      gap: 6px;
    }
    .v6-path__rail {
      grid-auto-flow: row;
      padding-left: 24px;
    }
    .v6-path__rail::before {
      left: 4px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }
    .v6-path__rail li {
      padding-top: 0;
    }
    .v6-path__dot {
      left: -24px;
      top: 4px;
    }
  }
</style>
