---
import SectionHeading from '../SectionHeading.astro';
import { openSourceEntries } from '~/data/open-source';
import { githubStars } from '~/data/github-stars';

const ranked = [...openSourceEntries]
  .map((item) => ({ item, stars: githubStars(item.url) ?? 0 }))
  .sort((a, b) => b.stars - a.stars);
const picks = ranked.slice(0, 6);
const repoName = (url: string) => url.replace(/^https:\/\/github\.com\/[^/]+\//, '').replace(/\/$/, '');
const categories = [...new Set(openSourceEntries.map((i) => i.category))].map((category) => {
  const items = ranked.filter((r) => r.item.category === category);
  return { category, count: items.length, top: items[0]?.item.title };
});
---

<section class="v6-section" id="opensource" data-tone="light" data-bg="moon-200" aria-labelledby="opensource-title">
  <div class="v6-container">
    <SectionHeading
      id="opensource-title"
      eyebrow="开源"
      title="把做事的方法，<br />开源成可用的工具。"
      lead={`自己在用的方法和工具，整理干净就放到 GitHub。现在有 ${openSourceEntries.length} 个，挑一个直接拿去改。`}
    />
    <div class="v6-os">
      <ol class="v6-repos">
        {
          picks.map(({ item, stars }, i) => (
            <li data-reveal style={`--reveal-i:${i % 2}`}>
              <a href={item.url} target="_blank" rel="noreferrer">
                <span class="v6-repos__head">
                  <code>{repoName(item.url)}</code>
                  {stars > 0 && <span class="v6-repos__stars">★ {stars}</span>}
                </span>
                <strong class="v6-repos__name">{item.title}</strong>
                <span class="v6-repos__desc">{item.description}</span>
                <span class="v6-repos__cat">{item.category}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <aside class="v6-os__index" aria-labelledby="os-index-title" data-reveal>
        <h3 id="os-index-title" class="v6-h4">按用途找</h3>
        <ul>
          {
            categories.map((c) => (
              <li>
                <a href={`/opensource?category=${encodeURIComponent(c.category)}`}>
                  <span class="v6-os__count">{String(c.count).padStart(2, '0')}</span>
                  <span class="v6-os__name">
                    <strong>{c.category}</strong>
                    {c.top && <small>例如 {c.top}</small>}
                  </span>
                  <span class="v6-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="v6-btn v6-btn--primary" href="/opensource">
          查看全部 {openSourceEntries.length} 个开源项目 <span class="v6-arrow" aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .v6-os {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    align-items: start;
  }
  .v6-repos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .v6-repos li {
    border-bottom: 1px solid var(--v6-line);
  }
  .v6-repos a {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 20px 0 22px;
    color: var(--ink);
    text-decoration: none;
  }
  .v6-repos__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .v6-repos code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 12.5px;
    color: var(--muted);
  }
  .v6-repos__stars {
    flex: none;
    font-family: var(--font-num);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--copper);
  }
  .v6-repos strong {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 900;
    letter-spacing: 0.02em;
    transition: color var(--dur-fast) ease;
  }
  .v6-repos a:hover strong {
    color: var(--copper);
  }
  .v6-repos__desc {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--body);
  }
  .v6-repos__cat {
    font-size: 12.5px;
    color: var(--muted);
  }
  .v6-os__index {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 20px;
    padding: 28px;
    border-radius: var(--radius-md);
    background: var(--card-light);
    box-shadow: var(--shadow-card);
  }
  .v6-os__index ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--v6-fg);
  }
  .v6-os__index li a {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--v6-line);
    color: var(--v6-fg);
    text-decoration: none;
    transition: background-color var(--dur-fast) ease;
  }
  .v6-os__index li a:hover {
    background: color-mix(in srgb, var(--v6-fg) 4%, transparent);
  }
  .v6-os__count {
    font-family: var(--font-num);
    font-size: 20px;
    font-weight: 600;
    color: var(--v6-accent);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .v6-os__name {
    display: grid;
    gap: 2px;
  }
  .v6-os__name strong {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 0.02em;
  }
  .v6-os__name small {
    font-size: 13px;
    color: var(--v6-fg-3);
  }
  .v6-os__index .v6-btn {
    width: 100%;
  }
  @media (max-width: 1023px) {
    .v6-os {
      grid-template-columns: 1fr;
    }
    .v6-os__index {
      position: static;
    }
  }
  @media (max-width: 767px) {
    .v6-repos {
      grid-template-columns: 1fr;
    }
    .v6-repos > :nth-child(n + 5) {
      display: none;
    }
    .v6-os__index {
      padding: 20px;
    }
    .v6-os__index .v6-btn {
      white-space: normal;
      text-align: center;
    }
  }
</style>
